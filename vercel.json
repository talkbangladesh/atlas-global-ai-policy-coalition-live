{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.coalition.atlasai.institute"
        }
      ],
      "destination": "https://coalition.atlasai.institute/$1",
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "coalitionmembers.atlasai.institute"
        }
      ],
      "destination": "https://coalition.atlasai.institute/$1",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.web3forms.com; form-action 'self' https://api.web3forms.com; base-uri 'self'; frame-ancestors https://*.manus.computer https://*.vercel.app https://coalition.atlasai.institute; object-src 'none'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/members/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/member-countries/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/countries/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/leadership/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/policy-research/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/initiatives/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/publications/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/news/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/events/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/contributions/:slug",
      "destination": "/index.html"
    }
  ]
}
